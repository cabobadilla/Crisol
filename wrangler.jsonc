{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crisol",
  "compatibility_date": "2026-10-07",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "crisol-ideas", "database_id": "42ae882e-4fba-4be8-8502-a19677e33715" }
  ]
}